{
  "name": "pi-spoke",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "license": "MIT",
  "engines": { "node": ">=24.15.0 <25" },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "typecheck": "tsc -p tsconfig.tests.json",
    "test": "vitest run tests/unit",
    "test:contract": "vitest run tests/contract",
    "test:integration": "npm run build && vitest run tests/integration",
    "test:sandbox": "npm run build && vitest run tests/sandbox",
    "test:live": "node scripts/live-gate.mjs",
    "verify": "npm run typecheck && npm test && npm run test:contract && npm run test:integration && npm run test:sandbox && npm run build"
  },
  "dependencies": {
    "@anthropic-ai/sandbox-runtime": "0.0.76",
    "@earendil-works/pi-ai": "0.85.1",
    "@earendil-works/pi-coding-agent": "0.85.1",
    "@modelcontextprotocol/sdk": "1.30.0",
    "typebox": "1.3.27",
    "zod": "4.6.4"
  },
  "devDependencies": {
    "@types/node": "24.13.4",
    "typescript": "5.9.3",
    "vitest": "4.1.11"
  }
}
